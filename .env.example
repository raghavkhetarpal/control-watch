# AWM ControlWatch - Environment Configuration
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql://awm:awm_password@localhost:5432/awm_controlwatch
POSTGRES_USER=awm
POSTGRES_PASSWORD=awm_password
POSTGRES_DB=awm_controlwatch

# AI Provider: "openai", "groq", or "none"
AI_PROVIDER=none
OPENAI_API_KEY=
GROQ_API_KEY=

# SEC Data
SEC_DATA_DIR=./data
SEC_DEFAULT_QUARTER=2025q3
SEC_SAMPLE_SIZE=5000

# Application
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Security
SECRET_KEY=change-this-to-a-random-secret-key
